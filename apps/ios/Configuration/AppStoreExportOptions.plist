<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- [01] Prepare an App Store Connect export for the ZHAW team. The export destination here does not upload
         or publish the app. -->
    <key>method</key><string>app-store-connect</string>
    <key>destination</key><string>export</string>
    <!-- [02] Xcode uses the team's available signing route; this file does not create a usable certificate or
         private key. -->
    <key>signingStyle</key><string>automatic</string>
    <key>teamID</key><string>PQ9M73T7N8</string>
    <!-- [03] Keep the reviewed version and build number instead of letting export change them. -->
    <key>manageAppVersionAndBuildNumber</key><false/>
    <!-- [04] Debug symbols help explain crashes in a distributed build; they are separate from the user's
         activity data. -->
    <key>uploadSymbols</key><true/>
</dict>
</plist>
