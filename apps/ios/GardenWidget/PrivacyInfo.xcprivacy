<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- [01] This is the widget bundle's privacy declaration. Check the final app and its linked libraries too; one
	     file does not describe every bundle. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- [02] The widget declares that it does not track people across other companies' apps or websites. -->
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
